---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { categoryLabelsRu, site } from '../../../lib/site';
import { itemListJsonLd, breadcrumbJsonLd } from '../../../lib/schema';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.lang === 'ru')).sort(
  (a, b) => (b.data.updatedAt ?? b.data.publishedAt).valueOf() - (a.data.updatedAt ?? a.data.publishedAt).valueOf()
);

const cats = Array.from(new Set(projects.map((p) => p.data.category)));

const description = 'Проверенные с точки зрения пользователя обзоры о проектах, компаниях и сервисах Узбекистана.';

const jsonLd = [
  itemListJsonLd({
    name: 'Все обзоры — Nisbiy.uz',
    description,
    items: projects.map((p) => {
      const slug = p.id.replace(/^(uz|ru)\//, '').replace(/\.[^.]+$/, '');
      return {
        name: p.data.title,
        url: new URL(`/ru/tahlillar/${slug}`, site.url).href,
        description: p.data.summary,
      };
    }),
  }),
  breadcrumbJsonLd([
    { name: 'Главная', url: new URL('/ru', site.url).href },
    { name: 'Обзоры', url: new URL('/ru/tahlillar', site.url).href },
  ]),
];
---

<BaseLayout
  title="Все обзоры"
  description={description}
  canonical="/ru/tahlillar"
  lang="ru"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-[var(--container-wide)] px-4 sm:px-6 pt-10 sm:pt-16">
    <header class="max-w-2xl">
      <p class="text-xs uppercase tracking-wider text-[color:var(--color-muted)]">Каталог</p>
      <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">Все обзоры</h1>
      <p class="mt-3 text-[color:var(--color-muted)]">
        По каждому проекту — проверенные факты и мнение команды. Источники всегда указаны.
      </p>
    </header>

    {
      cats.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href="/ru/tahlillar"
            class="rounded-full border border-[color:var(--color-ink)] dark:border-[color:var(--color-paper)] bg-[color:var(--color-ink)] dark:bg-[color:var(--color-paper)] text-[color:var(--color-paper)] dark:text-[color:var(--color-ink)] px-3 py-1 text-xs"
          >
            Все · {projects.length}
          </a>
          {cats.map((c) => (
            <a
              href={`/ru/tahlillar?category=${c}`}
              class="rounded-full border border-[color:var(--color-line)] dark:border-stone-800 px-3 py-1 text-xs text-[color:var(--color-muted)] hover:text-[color:var(--color-ink)] dark:hover:text-[color:var(--color-paper)] hover:border-[color:var(--color-ink)]/30"
            >
              {categoryLabelsRu[c]}
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="mx-auto max-w-[var(--container-wide)] px-4 sm:px-6 mt-10 pb-16">
    {
      projects.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-[color:var(--color-line)] dark:border-stone-800 p-10 text-center text-[color:var(--color-muted)]">
          <p>Пока обзоров нет. Скоро появятся первые материалы.</p>
        </div>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((entry) => (
            <ProjectCard entry={entry} lang="ru" />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
