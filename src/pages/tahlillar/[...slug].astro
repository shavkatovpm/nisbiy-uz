---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import FactList from '../../components/FactList.astro';
import FaqList from '../../components/FaqList.astro';
import CriteriaBreakdown from '../../components/CriteriaBreakdown.astro';
import { categoryLabels, site } from '../../lib/site';
import { projectJsonLd, breadcrumbJsonLd } from '../../lib/schema';
import { resolveRating } from '../../lib/rating';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft && data.lang === 'uz');
  return projects.map((p) => ({
    params: { slug: p.id.replace(/^(uz|ru)\//, '').replace(/\.[^.]+$/, '') },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const slug = entry.id.replace(/^(uz|ru)\//, '').replace(/\.[^.]+$/, '');
const canonical = `/tahlillar/${slug}`;
const fullUrl = new URL(canonical, site.url).href;

const focusQuestion = data.focusQuestion ?? `${data.title} ishonchlimi?`;
const pageTitle = `${focusQuestion} ${data.title} haqida to‘liq tahlil`;

const { bucket: rating, score } = resolveRating({ criteria: data.criteria, manual: data.rating });

const jsonLd = [
  ...projectJsonLd({
    title: data.title,
    summary: data.summary,
    url: fullUrl,
    rating,
    publishedAt: data.publishedAt,
    updatedAt: data.updatedAt,
    category: data.category,
    legalName: data.legalName,
    website: data.website,
    founded: data.founded,
    location: data.location,
    faq: data.faq,
  }),
  breadcrumbJsonLd([
    { name: 'Asosiy', url: site.url },
    { name: 'Tahlillar', url: new URL('/tahlillar', site.url).href },
    { name: data.title, url: fullUrl },
  ]),
];

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('uz-UZ', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

const dateToShow = data.updatedAt ?? data.publishedAt;
const dateLabel = data.updatedAt ? 'Yangilangan' : 'Chop etilgan';
---

<BaseLayout
  title={pageTitle}
  description={data.summary}
  image={data.ogImage ?? data.coverImage}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  canonical={canonical}
  jsonLd={jsonLd}
  mdAlternate={`${canonical}.md`}
>
  <article class="mx-auto max-w-[var(--container-content)] px-4 sm:px-6 pt-10 sm:pt-16 pb-16">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="text-xs text-[color:var(--color-muted)]">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:underline underline-offset-4">Asosiy</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/tahlillar" class="hover:underline underline-offset-4">Tahlillar</a></li>
        <li aria-hidden="true">/</li>
        <li class="truncate text-[color:var(--color-ink)] dark:text-[color:var(--color-paper)]">{data.title}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="uppercase tracking-wider text-[color:var(--color-muted)]">
          {categoryLabels[data.category]}
        </span>
        <span aria-hidden="true" class="text-[color:var(--color-muted)]">·</span>
        <time datetime={dateToShow.toISOString()} class="text-[color:var(--color-muted)]">
          {dateLabel}: {fmt(dateToShow)}
        </time>
      </div>
      <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight leading-tight text-balance">
        {focusQuestion}
      </h1>
      <p class="mt-3 text-sm uppercase tracking-wider text-[color:var(--color-muted)]">
        {data.title} — to‘liq tahlil va jamoa fikri
      </p>
      <p class="mt-5 text-lg text-[color:var(--color-muted)] leading-relaxed text-balance">
        {data.summary}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <RatingBadge rating={rating} score={score} />
        {
          data.website && (
            <a
              href={data.website}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="inline-flex items-center gap-1 text-xs text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)] hover:underline underline-offset-4"
            >
              {new URL(data.website).hostname.replace(/^www\./, '')}
              <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </a>
          )
        }
      </div>

      {
        (data.legalName || data.founded || data.location) && (
          <dl class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm border-t border-[color:var(--color-line)] dark:border-stone-800 pt-4">
            {data.legalName && (
              <div class="flex justify-between sm:block">
                <dt class="text-[color:var(--color-muted)]">Nomi</dt>
                <dd>{data.legalName}</dd>
              </div>
            )}
            {data.founded && (
              <div class="flex justify-between sm:block">
                <dt class="text-[color:var(--color-muted)]">Ish boshlagan</dt>
                <dd>{data.founded}</dd>
              </div>
            )}
            {data.location && (
              <div class="flex justify-between sm:block">
                <dt class="text-[color:var(--color-muted)]">Manzil</dt>
                <dd>{data.location}</dd>
              </div>
            )}
          </dl>
        )
      }
    </header>

    <!-- 1. Optional intro/body content -->
    {entry.body && entry.body.trim().length > 0 && (
      <section class="prose-nisbiy mt-12">
        <Content />
      </section>
    )}

    <!-- 1.5. Criteria breakdown (100 ballik mezon) -->
    {data.criteria && (
      <section id="mezonlar" class="mt-12 scroll-mt-20">
        <CriteriaBreakdown criteria={data.criteria} />
      </section>
    )}

    <!-- 2. Verified facts -->
    {
      data.facts.length > 0 && (
        <section id="faktlar" class="mt-12 scroll-mt-20">
          <div class="flex items-center gap-3">
            <SectionBadge kind="fact" label="Tekshirilgan faktlar" />
            <span class="text-xs text-[color:var(--color-muted)]">manbalar bilan</span>
          </div>
          <h2 class="sr-only">Tekshirilgan faktlar</h2>
          <div class="mt-4">
            <FactList facts={data.facts} />
          </div>
        </section>
      )
    }

    <!-- 3 + 4. Strengths & weaknesses -->
    {
      (data.strengths.length > 0 || data.weaknesses.length > 0) && (
        <section class="mt-12 grid gap-4 sm:grid-cols-2">
          {data.strengths.length > 0 && (
            <div id="kuchli-tomonlari" class="rounded-2xl border border-[color:var(--color-line)] dark:border-stone-800 p-5 scroll-mt-20">
              <SectionBadge kind="strength" label="Kuchli tomonlari" />
              <h2 class="sr-only">Kuchli tomonlari</h2>
              <ul class="mt-3 space-y-2 text-sm">
                {data.strengths.map((s) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="mt-1.5 size-1.5 shrink-0 rounded-full bg-[color:var(--color-fact)]" />
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {data.weaknesses.length > 0 && (
            <div id="zaif-tomonlari" class="rounded-2xl border border-[color:var(--color-line)] dark:border-stone-800 p-5 scroll-mt-20">
              <SectionBadge kind="warn" label="Zaif tomonlari" />
              <h2 class="sr-only">Zaif tomonlari</h2>
              <ul class="mt-3 space-y-2 text-sm">
                {data.weaknesses.map((s) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="mt-1.5 size-1.5 shrink-0 rounded-full bg-[color:var(--color-warn)]" />
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )
    }

    <!-- 5. Team opinion -->
    {
      data.opinion && (
        <section id="jamoa-fikri" class="mt-12 scroll-mt-20">
          <SectionBadge kind="opinion" label="Jamoa fikri" />
          <h2 class="sr-only">Jamoa fikri</h2>
          <blockquote class="mt-4 rounded-2xl bg-[color:var(--color-opinion-soft)]/40 border-l-4 border-[color:var(--color-opinion)] p-5 text-[color:var(--color-ink)] dark:text-[color:var(--color-paper)] dark:bg-stone-900/60">
            <p class="leading-relaxed">{data.opinion}</p>
            <footer class="mt-3 text-xs text-[color:var(--color-muted)]">
              Bu — Nisbiy.uz jamoasining subyektiv fikri. Yakuniy qaror sizniki.
            </footer>
          </blockquote>
        </section>
      )
    }

    <!-- 6. FAQ -->
    {
      data.faq.length > 0 && (
        <section id="faq" class="mt-12 scroll-mt-20">
          <h2 class="text-xl font-semibold tracking-tight">Tez-tez so‘raladigan savollar</h2>
          <div class="mt-4">
            <FaqList faq={data.faq} />
          </div>
        </section>
      )
    }

    <!-- Disclosure -->
    {
      data.disclosure && (
        <aside class="mt-12 rounded-xl border border-dashed border-[color:var(--color-line)] dark:border-stone-800 p-4 text-xs text-[color:var(--color-muted)]">
          <strong class="font-semibold text-[color:var(--color-ink)] dark:text-[color:var(--color-paper)]">Oshkor qilish:</strong>{' '}
          {data.disclosure}
        </aside>
      )
    }

    <!-- Footer of article -->
    <footer class="mt-12 border-t border-[color:var(--color-line)] dark:border-stone-800 pt-6 flex flex-wrap items-center justify-between gap-3 text-xs text-[color:var(--color-muted)]">
      <a href="/tahlillar" class="hover:underline underline-offset-4">← Barcha tahlillar</a>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <a href={`${canonical}.md`} class="hover:underline underline-offset-4">Markdown versiya</a>
        <span aria-hidden="true">·</span>
        <span>Sitatalashda: <code class="font-mono">{fullUrl}</code></span>
      </div>
    </footer>
  </article>
</BaseLayout>
