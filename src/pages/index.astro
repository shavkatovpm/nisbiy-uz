---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RatingBadge from '../components/RatingBadge.astro';
import { categoryLabels, site } from '../lib/site';
import { resolveRating } from '../lib/rating';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.updatedAt ?? b.data.publishedAt).valueOf() - (a.data.updatedAt ?? a.data.publishedAt).valueOf());

const featured = projects[0];
const rest = projects.slice(1, 4);

const featuredSlug = featured?.id.replace(/\.[^.]+$/, '');
const featuredRating = featured ? resolveRating({ criteria: featured.data.criteria, manual: featured.data.rating }) : null;
---

<BaseLayout title={site.name} description={site.description} canonical="/">
  <!-- ════ SECTION 1: HERO ════ -->
  <section class="hero-section relative overflow-hidden">
    <div aria-hidden="true" class="hero-bg pointer-events-none absolute inset-0 -z-10">
      <div class="hero-glow absolute size-[22rem] sm:size-[26rem] rounded-full bg-stone-500/10 blur-3xl"></div>
      <div class="hero-glow-soft absolute size-[14rem] rounded-full bg-stone-400/10 blur-2xl"></div>
    </div>

    <!-- Spotlight reveal: methodology keywords lit when the glow circle visits each one -->
    <div aria-hidden="true" class="hero-spotlight pointer-events-none absolute inset-0 -z-10 hidden sm:block">
      <span class="spot-word" style="left:72%; top:22%; font-size:clamp(2.5rem, 5vw, 4rem); --r:-2deg;">Faktlar</span>
      <span class="spot-word" style="left:80%; top:52%; font-size:clamp(2.25rem, 4.5vw, 3.5rem); --r:1deg;">Fikrlar</span>
      <span class="spot-word" style="left:68%; top:80%; font-size:clamp(2rem, 4vw, 3rem); --r:-1deg;">Manbalar</span>
      <span class="spot-word" style="left:34%; top:82%; font-size:clamp(2rem, 4vw, 3rem); --r:2deg;">Mezonlar</span>
      <span class="spot-word" style="left:14%; top:76%; font-size:clamp(2rem, 4vw, 3rem); --r:-1deg;">Tekshiruv</span>
    </div>

    <div class="mx-auto max-w-[var(--container-wide)] w-full px-4 sm:px-6 pt-20 pb-32 sm:pt-32 sm:pb-40 lg:pt-40 lg:pb-48">
      <p class="hero-reveal text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)]" style="--delay:0ms">Nisbiy — mutlaq emas</p>
      <h1 class="hero-reveal mt-4 text-4xl sm:text-6xl font-semibold tracking-tight leading-[1.05] max-w-3xl" style="--delay:80ms">
        Tekshirilgan faktlar. <br class="hidden sm:block" />
        <span class="text-[color:var(--color-muted)]">Ochiq fikrlar.</span>
      </h1>
      <p class="hero-reveal mt-6 max-w-xl text-lg text-[color:var(--color-muted)] leading-relaxed" style="--delay:180ms">
        O‘zbekistondagi loyihalar, kompaniyalar va xizmatlar haqida foydalanuvchi nuqtai nazaridan tekshirilgan ma’lumotlar va subyektiv tavsiyalar. Yakuniy qaror — sizniki.
      </p>
      <div class="hero-reveal mt-8 flex flex-wrap items-center gap-3" style="--delay:280ms">
        <a href="/tahlillar" class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-ink)] dark:bg-[color:var(--color-paper)] text-[color:var(--color-paper)] dark:text-[color:var(--color-ink)] px-5 py-2.5 text-sm font-medium hover:opacity-90 transition">
          Tahlillarni ko‘rish
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        <a href="/metodologiya" class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-line)] dark:border-stone-700 px-5 py-2.5 text-sm font-medium hover:bg-[color:var(--color-paper-soft)] dark:hover:bg-stone-900 transition">
          Qanday tekshiramiz
        </a>
      </div>
    </div>

    <a href="#printsiplar" aria-label="Pastga aylantirish" class="hero-scroll absolute bottom-8 left-1/2 -translate-x-1/2 inline-flex flex-col items-center gap-1 text-[color:var(--color-muted)] hover:text-[color:var(--color-ink)] dark:hover:text-[color:var(--color-paper)] transition-colors">
      <span class="text-[10px] uppercase tracking-wider">Davom etish</span>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </a>
  </section>

  <!-- Wave divider: two layered drifting sea lines at the hero/printsiplar seam -->
  <div aria-hidden="true" class="wave-divider relative w-full">
    <svg class="wave-back" viewBox="0 0 1200 40" preserveAspectRatio="none">
      <path d="M0,20 Q150,4 300,20 T600,20 T900,20 T1200,20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <svg class="wave-front" viewBox="0 0 1200 40" preserveAspectRatio="none">
      <path d="M0,22 Q150,38 300,18 T600,22 T900,18 T1200,22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </div>

  <!-- ════ SECTION 2: PRINTSIPLAR ════ -->
  <section
    id="printsiplar"
    class="relative overflow-hidden scroll-mt-14"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 grid-pattern opacity-[0.35] dark:opacity-[0.18]"></div>

    <div class="mx-auto max-w-[var(--container-wide)] w-full px-4 sm:px-6 py-24 sm:py-32 lg:py-40">
      <div class="grid gap-10 lg:gap-16 lg:grid-cols-[1fr_1.4fr] lg:items-start">
        <!-- Left: section intro -->
        <div class="lg:sticky lg:top-24 scroll-reveal" style="--delay:0ms">
          <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)]">Bizning printsipimiz</p>
          <h2 class="mt-4 text-3xl sm:text-5xl font-semibold tracking-tight leading-[1.05]">
            Uch sodda qoida.
          </h2>
          <p class="mt-5 text-[color:var(--color-muted)] leading-relaxed max-w-md">
            Har bir tahlilimiz shu uch printsipga asoslangan. Bittasi buzilsa, biz uni chop etmaymiz.
          </p>
          <a href="/metodologiya" class="mt-6 inline-flex items-center gap-2 text-sm font-medium hover:underline underline-offset-4">
            To‘liq metodologiya
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>

        <!-- Right: 3 manifesto cards with vertical connector -->
        <ol class="relative space-y-10 sm:space-y-14" role="list">
          <!-- vertical connector -->
          <div aria-hidden="true" class="draw-line absolute left-[1.5rem] sm:left-[1.75rem] top-3 bottom-3 w-px bg-gradient-to-b from-[color:var(--color-fact)] via-[color:var(--color-opinion)] to-[color:var(--color-accent)] origin-top"></div>

          <li class="scroll-reveal relative flex gap-5 sm:gap-7" style="--delay:120ms">
            <div class="relative shrink-0">
              <div class="flex items-center justify-center size-12 sm:size-14 rounded-full bg-[color:var(--color-fact-soft)] text-[color:var(--color-fact)] font-mono text-sm font-semibold ring-4 ring-[color:var(--color-paper)] dark:ring-[color:var(--color-ink)]">
                01
              </div>
            </div>
            <div class="flex-1 pt-2">
              <div class="text-xs uppercase tracking-wider text-[color:var(--color-fact)] font-semibold">Faktlar</div>
              <h3 class="mt-1 text-2xl sm:text-3xl font-semibold tracking-tight">Tekshirilgan ma‘lumotlar.</h3>
              <p class="mt-3 text-[color:var(--color-muted)] leading-relaxed max-w-prose">
                Manba ko‘rsatilmagan bironta da‘vo bizning tahlilda joy olmaydi. Saytlar, ijtimoiy tarmoqlar,
                mijoz fikrlari — siz ham takrorlay oladigan manbalar.
              </p>
            </div>
          </li>

          <li class="scroll-reveal relative flex gap-5 sm:gap-7" style="--delay:220ms">
            <div class="relative shrink-0">
              <div class="flex items-center justify-center size-12 sm:size-14 rounded-full bg-[color:var(--color-opinion-soft)] text-[color:var(--color-opinion)] font-mono text-sm font-semibold ring-4 ring-[color:var(--color-paper)] dark:ring-[color:var(--color-ink)]">
                02
              </div>
            </div>
            <div class="flex-1 pt-2">
              <div class="text-xs uppercase tracking-wider text-[color:var(--color-opinion)] font-semibold">Fikrlar</div>
              <h3 class="mt-1 text-2xl sm:text-3xl font-semibold tracking-tight">Ochiq subyektivlik.</h3>
              <p class="mt-3 text-[color:var(--color-muted)] leading-relaxed max-w-prose">
                Bizning fikrimiz alohida bo‘limda, aniq belgilab beriladi. Fakt va fikr aralashtirilmaydi —
                qaysi gap manbadan, qaysi biri jamoadan ekani har doim ko‘rinib turadi.
              </p>
            </div>
          </li>

          <li class="scroll-reveal relative flex gap-5 sm:gap-7" style="--delay:320ms">
            <div class="relative shrink-0">
              <div class="flex items-center justify-center size-12 sm:size-14 rounded-full bg-[color:var(--color-accent-soft)] text-[color:var(--color-accent)] font-mono text-sm font-semibold ring-4 ring-[color:var(--color-paper)] dark:ring-[color:var(--color-ink)]">
                03
              </div>
            </div>
            <div class="flex-1 pt-2">
              <div class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] font-semibold">Yakuniy qaror</div>
              <h3 class="mt-1 text-2xl sm:text-3xl font-semibold tracking-tight">Yakuniy qaror sizniki.</h3>
              <p class="mt-3 text-[color:var(--color-muted)] leading-relaxed max-w-prose">
                Biz faktlarni va fikrimizni beramiz — lekin tanlovni siz qilasiz. Nisbiy.uz yakuniy “javob” emas,
                qaroringizni qabul qilish jarayonidagi manbalardan biri.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ════ SECTION 3: NISBIY DEMO — "Bir fakt. Ikki qaror." ════ -->
  <section class="relative border-t border-[color:var(--color-line)] dark:border-stone-800 overflow-hidden">
    <div class="mx-auto max-w-[var(--container-wide)] w-full px-4 sm:px-6 py-24 sm:py-32 lg:py-40">
      <div class="scroll-reveal max-w-2xl">
        <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)]">Nisbiy nega “nisbiy”?</p>
        <h2 class="mt-4 text-3xl sm:text-5xl font-semibold tracking-tight leading-[1.05]">
          Bir fakt. <span class="text-[color:var(--color-muted)]">Ikki qaror.</span>
        </h2>
        <p class="mt-5 text-[color:var(--color-muted)] leading-relaxed">
          Bizning vazifamiz — “to‘g‘ri javob” aytish emas. Bir xil fakt qanchalik turlicha o‘qilishi
          mumkinligini ko‘rib chiqing.
        </p>
      </div>

      <!-- Fact card -->
      <figure class="scroll-reveal relative mt-12 mx-auto max-w-3xl" style="--delay:120ms">
        <span class="absolute -top-3 left-6 inline-flex items-center gap-1.5 rounded-full bg-[color:var(--color-fact-soft)] text-[color:var(--color-fact)] px-3 py-1 text-[11px] uppercase tracking-wider font-semibold">
          <span aria-hidden="true" class="size-1.5 rounded-full bg-current"></span>
          Fakt
        </span>
        <blockquote class="rounded-3xl border border-[color:var(--color-line)] dark:border-stone-800 bg-[color:var(--color-paper-soft)]/40 dark:bg-stone-900/40 px-6 sm:px-10 py-8 sm:py-10">
          <p class="text-xl sm:text-2xl leading-relaxed font-medium text-balance">
            “X loyihasi 2024-yilda boshlangan va hozirda 12 mingdan ortiq foydalanuvchisi bor.”
          </p>
        </blockquote>
      </figure>

      <!-- Splitter / balance indicator -->
      <div aria-hidden="true" class="scroll-reveal mt-10 flex flex-col items-center gap-2 text-[color:var(--color-muted)]" style="--delay:220ms">
        <div class="h-8 w-px bg-current opacity-30"></div>
        <span class="text-[10px] uppercase tracking-[0.2em]">Ikki tomondan</span>
        <div class="h-8 w-px bg-current opacity-30"></div>
      </div>

      <!-- Two lenses (perspectives) -->
      <div class="mt-6 grid gap-5 lg:grid-cols-2">
        <article
          class="lens-card scroll-reveal group relative rounded-3xl border border-[color:var(--color-line)] dark:border-stone-800 p-7 sm:p-8 overflow-hidden bg-[color:var(--color-paper)] dark:bg-stone-950/50"
          style="--delay:320ms"
        >
          <div aria-hidden="true" class="lens-accent absolute top-0 inset-x-0 h-[3px] bg-[color:var(--color-fact)] origin-left"></div>
          <div class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-[color:var(--color-fact)] font-semibold">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 12 10 16 18 8" />
            </svg>
            Bir tomondan
          </div>
          <h3 class="mt-3 text-xl sm:text-2xl font-semibold tracking-tight">Tez o‘sayotgan loyiha.</h3>
          <p class="mt-3 text-[color:var(--color-muted)] leading-relaxed">
            2 yilda 12 ming foydalanuvchi — yaxshi sur‘at. Yangi yondashuv, zamonaviy texnologiya,
            eski cheklovlardan ozod. Sezgir auditoriyaga moslashishga ulguradi.
          </p>
        </article>

        <article
          class="lens-card scroll-reveal group relative rounded-3xl border border-[color:var(--color-line)] dark:border-stone-800 p-7 sm:p-8 overflow-hidden bg-[color:var(--color-paper)] dark:bg-stone-950/50"
          style="--delay:420ms"
        >
          <div aria-hidden="true" class="lens-accent absolute top-0 inset-x-0 h-[3px] bg-[color:var(--color-opinion)] origin-right"></div>
          <div class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-[color:var(--color-opinion)] font-semibold">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <line x1="12" y1="8" x2="12" y2="13" />
              <line x1="12" y1="16.5" x2="12" y2="17" />
            </svg>
            Ikkinchi tomondan
          </div>
          <h3 class="mt-3 text-xl sm:text-2xl font-semibold tracking-tight">Tajriba hali yangi.</h3>
          <p class="mt-3 text-[color:var(--color-muted)] leading-relaxed">
            2 yil — bozor o‘zgarishlari va krizislarda qanday tutsa, hali ko‘rinmagan. 12 ming —
            ko‘p, ammo 100 ming bilan solishtirsa, hozircha kichik. Uzoq muddatga ishonchi noma‘lum.
          </p>
        </article>
      </div>

      <!-- Punchline -->
      <div class="scroll-reveal mt-12 max-w-3xl mx-auto text-center" style="--delay:560ms">
        <p class="text-lg sm:text-xl text-[color:var(--color-muted)] leading-relaxed">
          Bir xil fakt — ikki xil vazn.
        </p>
        <p class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight leading-tight text-balance">
          Sizning vazningiz — <span class="text-[color:var(--color-accent)]">sizning qaroringiz.</span>
        </p>
        <p class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)]">
          <span aria-hidden="true" class="inline-block size-1 rounded-full bg-[color:var(--color-accent)]"></span>
          Shuning uchun biz nisbiy
        </p>
      </div>
    </div>
  </section>

  <!-- ════ SECTION 4: SO'NGGI TAHLILLAR (magazine-style) ════ -->
  <section class="relative border-t border-[color:var(--color-line)] dark:border-stone-800 overflow-hidden">
    <!-- diagonal background accent -->
    <div aria-hidden="true" class="pointer-events-none absolute -top-32 -right-32 size-[28rem] rounded-full bg-[color:var(--color-opinion-soft)]/30 dark:bg-[color:var(--color-opinion)]/10 blur-3xl"></div>

    <div class="mx-auto max-w-[var(--container-wide)] w-full px-4 sm:px-6 py-24 sm:py-32 lg:py-40">
      <!-- Header -->
      <div class="scroll-reveal flex items-end justify-between gap-4 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)]">Yangi nashr</p>
          <h2 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight leading-[1.05]">
            So‘nggi tahlillar.
          </h2>
          <p class="mt-3 text-[color:var(--color-muted)] max-w-md">
            Yangilangan kontent va yangi loyihalar haqida tahlillarimiz.
          </p>
        </div>
        <a href="/tahlillar" class="group inline-flex items-center gap-2 text-sm font-medium">
          <span class="relative">
            Barchasi
            <span aria-hidden="true" class="absolute inset-x-0 -bottom-1 h-px bg-current scale-x-100 group-hover:scale-x-0 origin-right transition-transform duration-300"></span>
            <span aria-hidden="true" class="absolute inset-x-0 -bottom-1 h-px bg-current scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 delay-150"></span>
          </span>
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>

      {projects.length === 0 ? (
        <div class="scroll-reveal mt-12 rounded-3xl border border-dashed border-[color:var(--color-line)] dark:border-stone-800 p-16 text-center text-[color:var(--color-muted)]" style="--delay:120ms">
          <p class="text-lg">Tez orada birinchi tahlillar paydo bo‘ladi.</p>
          <p class="mt-2 text-sm">Hozircha — tizim tayyor.</p>
        </div>
      ) : (
        <div class="mt-10 sm:mt-14 grid gap-6 lg:grid-cols-5 lg:items-stretch">
          <!-- Featured (big) -->
          {featured && (
            <a
              href={`/tahlillar/${featuredSlug}`}
              class="scroll-reveal group relative lg:col-span-3 rounded-3xl border border-[color:var(--color-line)] dark:border-stone-800 p-7 sm:p-10 flex flex-col overflow-hidden transition-all hover:border-[color:var(--color-ink)]/30 dark:hover:border-stone-600"
              style="--delay:120ms"
            >
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[color:var(--color-accent-soft)]/30 via-transparent to-[color:var(--color-opinion-soft)]/30 dark:from-[color:var(--color-accent)]/5 dark:to-[color:var(--color-opinion)]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

              <div class="relative flex items-center gap-2 text-xs">
                <span class="px-2 py-0.5 rounded-full bg-[color:var(--color-ink)] dark:bg-[color:var(--color-paper)] text-[color:var(--color-paper)] dark:text-[color:var(--color-ink)] font-medium">
                  Tanlangan
                </span>
                <span class="uppercase tracking-wider text-[color:var(--color-muted)]">
                  {categoryLabels[featured.data.category]}
                </span>
              </div>

              <h3 class="relative mt-6 text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight leading-[1.05] group-hover:text-[color:var(--color-accent)] transition-colors">
                {featured.data.title}
              </h3>

              <p class="relative mt-4 text-[color:var(--color-muted)] leading-relaxed line-clamp-4 sm:line-clamp-5">
                {featured.data.summary}
              </p>

              <div class="relative mt-auto pt-6 flex items-center justify-between gap-3">
                <RatingBadge rating={featuredRating!.bucket} score={featuredRating!.score} />
                <span class="inline-flex items-center gap-1 text-sm font-medium">
                  To‘liq tahlil
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1">
                    <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
                  </svg>
                </span>
              </div>
            </a>
          )}

          <!-- Side stack -->
          <div class="lg:col-span-2 grid gap-4 content-start">
            {rest.length === 0 && featured && (
              <div class="scroll-reveal rounded-3xl border border-dashed border-[color:var(--color-line)] dark:border-stone-800 p-8 text-sm text-[color:var(--color-muted)]" style="--delay:220ms">
                <p class="font-medium text-[color:var(--color-ink)] dark:text-[color:var(--color-paper)]">Yangi tahlillar yo‘lda</p>
                <p class="mt-2">Birinchi tahlillarimiz e‘lon qilingach, shu yerda paydo bo‘ladi.</p>
              </div>
            )}
            {rest.map((entry, idx) => {
              const slug = entry.id.replace(/\.[^.]+$/, '');
              const date = entry.data.updatedAt ?? entry.data.publishedAt;
              const { bucket, score } = resolveRating({ criteria: entry.data.criteria, manual: entry.data.rating });
              return (
                <a
                  href={`/tahlillar/${slug}`}
                  class="scroll-reveal group rounded-2xl border border-[color:var(--color-line)] dark:border-stone-800 p-5 hover:border-[color:var(--color-ink)]/30 dark:hover:border-stone-600 transition-all"
                  style={`--delay:${220 + idx * 80}ms`}
                >
                  <div class="flex items-center justify-between gap-2 text-xs text-[color:var(--color-muted)]">
                    <span class="uppercase tracking-wider">{categoryLabels[entry.data.category]}</span>
                    <time datetime={date.toISOString()}>
                      {new Intl.DateTimeFormat('uz-UZ', { month: 'short', day: 'numeric' }).format(date)}
                    </time>
                  </div>
                  <h3 class="mt-2 text-lg font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors line-clamp-2">
                    {entry.data.title}
                  </h3>
                  <div class="mt-3">
                    <RatingBadge rating={bucket} score={score} size="sm" />
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ════ SECTION 5: BUYURTMA — "Sizning loyihangiz AI javoblarida" ════ -->
  <section class="relative border-t border-[color:var(--color-line)] dark:border-stone-800 overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
