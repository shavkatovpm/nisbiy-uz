---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogCategoryLabels, site } from '../../lib/site';
import { itemListJsonLd, breadcrumbJsonLd } from '../../lib/schema';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'uz')).sort(
  (a, b) =>
    (b.data.updatedAt ?? b.data.publishedAt).valueOf() -
    (a.data.updatedAt ?? a.data.publishedAt).valueOf()
);

const cats = Array.from(new Set(posts.map((p) => p.data.category)));

const description = "O‘zbekistondagi mahsulot va xizmatlar haqida yo‘riqnomalar, ro‘yxatlar, taqqoslashlar va fikrlar.";

const jsonLd = [
  itemListJsonLd({
    name: 'Blog — Nisbiy.uz',
    description,
    items: posts.map((p) => {
      const slug = p.id.replace(/^(uz|ru)\//, '').replace(/\.[^.]+$/, '');
      return {
        name: p.data.title,
        url: new URL(`/blog/${slug}`, site.url).href,
        description: p.data.summary,
      };
    }),
  }),
  breadcrumbJsonLd([
    { name: 'Asosiy', url: site.url },
    { name: 'Blog', url: new URL('/blog', site.url).href },
  ]),
];
---

<BaseLayout
  title="Blog"
  description={description}
  canonical="/blog"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-[var(--container-wide)] px-4 sm:px-6 pt-10 sm:pt-16">
    <header class="max-w-2xl">
      <p class="text-xs uppercase tracking-wider text-[color:var(--color-muted)]">Blog</p>
      <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">Yo‘riqnomalar va maqolalar</h1>
      <p class="mt-3 text-[color:var(--color-muted)]">
        Tahlillardan farqli o‘laroq, blog mavzular bo‘yicha tushuntirishlar, ro‘yxatlar va taqqoslashlardan iborat.
      </p>
    </header>

    {
      cats.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href="/blog"
            class="rounded-full border border-[color:var(--color-ink)] dark:border-[color:var(--color-paper)] bg-[color:var(--color-ink)] dark:bg-[color:var(--color-paper)] text-[color:var(--color-paper)] dark:text-[color:var(--color-ink)] px-3 py-1 text-xs"
          >
            Hammasi · {posts.length}
          </a>
          {cats.map((c) => (
            <a
              href={`/blog?category=${c}`}
              class="rounded-full border border-[color:var(--color-line)] dark:border-stone-800 px-3 py-1 text-xs text-[color:var(--color-muted)] hover:text-[color:var(--color-ink)] dark:hover:text-[color:var(--color-paper)] hover:border-[color:var(--color-ink)]/30"
            >
              {blogCategoryLabels[c]}
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="mx-auto max-w-[var(--container-wide)] px-4 sm:px-6 mt-10 pb-16">
    {
      posts.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-[color:var(--color-line)] dark:border-stone-800 p-10 text-center text-[color:var(--color-muted)]">
          <p>Hozircha maqola yo‘q. Tez orada birinchi blog postlari paydo bo‘ladi.</p>
        </div>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((entry) => {
            const slug = entry.id.replace(/^(uz|ru)\//, '').replace(/\.[^.]+$/, '');
            const date = entry.data.updatedAt ?? entry.data.publishedAt;
            return (
              <article class="group">
                <a
                  href={`/blog/${slug}`}
                  class="block rounded-2xl border border-[color:var(--color-line)] dark:border-stone-800 p-5 sm:p-6 transition-all hover:border-[color:var(--color-ink)]/30 dark:hover:border-stone-600 hover:-translate-y-0.5"
                >
                  <div class="flex items-center gap-2 text-xs text-[color:var(--color-muted)]">
                    <span class="uppercase tracking-wider">{blogCategoryLabels[entry.data.category]}</span>
                    <span aria-hidden="true">·</span>
                    <time datetime={date.toISOString()}>
                      {new Intl.DateTimeFormat('uz-UZ', { year: 'numeric', month: 'short', day: 'numeric' }).format(date)}
                    </time>
                  </div>
                  <h3 class="mt-2 text-xl font-semibold tracking-tight text-[color:var(--color-ink)] dark:text-[color:var(--color-paper)] group-hover:text-[color:var(--color-accent)] transition-colors">
                    {entry.data.focusQuestion ?? entry.data.title}
                  </h3>
                  <p class="mt-2 text-sm text-[color:var(--color-muted)] line-clamp-3 leading-relaxed">
                    {entry.data.summary}
                  </p>
                </a>
              </article>
            );
          })}
        </div>
      )
    }
  </section>
</BaseLayout>
