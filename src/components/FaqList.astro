---
interface Props {
  faq: { q: string; a: string }[];
}
const { faq } = Astro.props;
---

<div class="space-y-2 not-prose">
  {
    faq.map((item) => (
      <details class="group rounded-xl border border-[color:var(--color-line)] dark:border-stone-800 bg-[color:var(--color-paper-soft)]/40 dark:bg-stone-900/40 p-4 open:bg-[color:var(--color-paper-soft)] dark:open:bg-stone-900 transition-colors">
        <summary class="flex cursor-pointer items-start justify-between gap-4 font-medium text-[color:var(--color-ink)] dark:text-[color:var(--color-paper)] list-none">
          <span class="flex-1">{item.q}</span>
          <span aria-hidden="true" class="shrink-0 mt-0.5 inline-flex items-center justify-center size-5 rounded-full text-[color:var(--color-muted)] group-open:rotate-45 transition-transform">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="12" y1="5" x2="12" y2="19" />
              <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
          </span>
        </summary>
        <p class="mt-3 text-[color:var(--color-muted)] leading-relaxed">{item.a}</p>
      </details>
    ))
  }
</div>
