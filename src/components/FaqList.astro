---
interface Props {
  faq: { q: string; a: string }[];
  /** Accordion guruh nomi — bir vaqtning o'zida faqat bittasi ochiq turishi uchun */
  name?: string;
}
const { faq, name = 'faq' } = Astro.props;
---

<div class="faq-group space-y-2 not-prose">
  {
    faq.map((item) => (
      <details
        name={name}
        class="faq-item group rounded-xl border border-[color:var(--color-line)] dark:border-stone-800 bg-[color:var(--color-paper-soft)]/40 dark:bg-stone-900/40 px-4 sm:px-5 py-3.5 open:bg-[color:var(--color-paper-soft)] dark:open:bg-stone-900 open:border-[color:var(--color-ink)]/15 dark:open:border-stone-700 transition-colors"
      >
        <summary class="flex cursor-pointer items-start justify-between gap-4 font-medium text-[color:var(--color-ink)] dark:text-[color:var(--color-paper)] list-none">
          <span class="flex-1">{item.q}</span>
          <span
            aria-hidden="true"
            class="shrink-0 mt-0.5 inline-flex items-center justify-center size-5 rounded-full text-[color:var(--color-muted)] group-open:rotate-45 transition-transform duration-300 ease-out"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="12" y1="5" x2="12" y2="19" />
              <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
          </span>
        </summary>
        <div class="faq-content">
          <div class="faq-content-inner">
            <p class="pt-3 text-[color:var(--color-muted)] leading-relaxed">{item.a}</p>
          </div>
        </div>
      </details>
    ))
  }
</div>

<style>
  /* Smooth open/close using grid-template-rows 0fr → 1fr (no JS, no height calc) */
  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faq-content-inner {
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.32s ease 0.04s,
      transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }
  details[open] > .faq-content {
    grid-template-rows: 1fr;
  }
  details[open] > .faq-content > .faq-content-inner {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-content,
    .faq-content-inner {
      transition: none;
    }
  }
</style>
