---
interface Props {
  size?: number;
  showText?: boolean;
  textClass?: string;
  class?: string;
}

const {
  size = 22,
  showText = true,
  textClass = '',
  class: className = '',
} = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <circle cx="16" cy="7" r="3" class="fill-[color:var(--color-ink)] dark:fill-[color:var(--color-paper)]" />
    <rect x="6" y="14" width="20" height="4" rx="2" class="fill-[color:var(--color-accent)]" />
    <circle cx="16" cy="25" r="3" class="fill-[color:var(--color-ink)] dark:fill-[color:var(--color-paper)]" />
  </svg>
  {
    showText && (
      <span class:list={['font-semibold tracking-tight', textClass]}>
        nisbiy<span class="text-[color:var(--color-muted)]">.uz</span>
      </span>
    )
  }
</span>
