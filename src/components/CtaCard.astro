---
import { ctaTypeLabels, ctaTypeLabelsRu } from '../lib/site';
import type { Lang } from '../lib/i18n';

interface Props {
  label: string;
  url: string;
  description?: string;
  type?: keyof typeof ctaTypeLabels;
  lang?: Lang;
}

const { label, url, description, type = 'editorial', lang = 'uz' } = Astro.props;
const meta = (lang === 'ru' ? ctaTypeLabelsRu : ctaTypeLabels)[type];
const goToSiteLabel = lang === 'ru' ? 'Перейти на сайт' : 'Saytga o‘tish';

const toneClasses: Record<string, string> = {
  muted:
    'border-[color:var(--color-line)] dark:border-stone-800 bg-[color:var(--color-paper-soft)]/40 dark:bg-stone-900/40',
  accent:
    'border-[color:var(--color-accent)]/30 bg-[color:var(--color-accent-soft)]/30 dark:bg-[color:var(--color-accent)]/8',
  opinion:
    'border-[color:var(--color-opinion)]/30 bg-[color:var(--color-opinion-soft)]/30 dark:bg-[color:var(--color-opinion)]/8',
};

const badgeClasses: Record<string, string> = {
  muted: 'bg-[color:var(--color-paper-soft)] text-[color:var(--color-muted)] dark:bg-stone-800 dark:text-stone-400',
  accent: 'bg-[color:var(--color-accent-soft)] text-[color:var(--color-accent)]',
  opinion: 'bg-[color:var(--color-opinion-soft)] text-[color:var(--color-opinion)]',
};

const hostname = (() => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
})();
---

<aside class:list={['not-prose my-6 rounded-2xl border p-5 sm:p-6', toneClasses[meta.tone]]}>
  <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
    <span class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-medium uppercase tracking-wider', badgeClasses[meta.tone]]}>
      <span aria-hidden="true" class="size-1.5 rounded-full bg-current"></span>
      {meta.label}
    </span>
    <span class="text-[color:var(--color-muted)] font-mono">{hostname}</span>
  </div>

  <h4 class="mt-3 text-lg font-semibold tracking-tight text-[color:var(--color-ink)] dark:text-[color:var(--color-paper)]">
    {label}
  </h4>

  {description && (
    <p class="mt-2 text-sm text-[color:var(--color-muted)] leading-relaxed">{description}</p>
  )}

  <div class="mt-4">
    <a
      href={url}
      target="_blank"
      rel={type === 'sponsored' || type === 'partner' ? 'noopener sponsored' : 'noopener noreferrer'}
      class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-ink)] dark:bg-[color:var(--color-paper)] text-[color:var(--color-paper)] dark:text-[color:var(--color-ink)] px-4 py-2 text-sm font-medium hover:opacity-90 transition"
    >
      {goToSiteLabel}
      <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" />
        <polyline points="15 3 21 3 21 9" />
        <line x1="10" y1="14" x2="21" y2="3" />
      </svg>
    </a>
  </div>
</aside>
