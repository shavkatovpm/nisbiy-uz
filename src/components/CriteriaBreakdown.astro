---
import { criteriaLabels, criteriaLabelsRu } from '../lib/site';
import { scoreCriteria, totalScore, type Criteria, type CriterionKey } from '../lib/rating';
import type { Lang } from '../lib/i18n';

interface Props {
  criteria: Criteria;
  lang?: Lang;
}

const { criteria, lang = 'uz' } = Astro.props;

const scored = scoreCriteria(criteria);
const total = totalScore(criteria) ?? 0;
const labels = lang === 'ru' ? criteriaLabelsRu : criteriaLabels;

const colorFor = (score: number) => {
  if (score >= 8) return 'fact';
  if (score >= 5) return 'opinion';
  return 'warn';
};

const tone: Record<string, string> = {
  fact: 'bg-[color:var(--color-fact)]',
  opinion: 'bg-[color:var(--color-opinion)]',
  warn: 'bg-[color:var(--color-warn)]',
  muted: 'bg-[color:var(--color-line)] dark:bg-stone-700',
};

// Group order — picked from current locale's labels so grouping survives translation
const groupOrder = lang === 'ru'
  ? ['Идентичность и доверие', 'Предложение и условия', 'Качество', 'Репутация']
  : ['Identitet va ishonch', 'Taklif va shartlar', 'Sifat', 'Reputatsiya'];

const grouped = groupOrder.map((g) => ({
  group: g,
  items: scored.filter(({ key }) => labels[key as CriterionKey].group === g),
}));

const headingLabel = lang === 'ru' ? 'Критерии оценки' : 'Baholash mezonlari';
const subText = lang === 'ru'
  ? 'Каждый критерий — 0–10 баллов. Если не применим к проекту — нейтральные 5 баллов.'
  : 'Har mezon 0–10 ball. Loyihaga taalluqli bo‘lmagani — neytral 5 ball.';
---

<div class="not-prose">
  <div class="flex items-baseline justify-between gap-3">
    <h2 class="text-xl font-semibold tracking-tight">{headingLabel}</h2>
    <div class="text-right">
      <div class="font-mono text-3xl sm:text-4xl font-semibold tabular-nums tracking-tight">
        {total}<span class="text-[color:var(--color-muted)] text-xl">/100</span>
      </div>
    </div>
  </div>

  <p class="mt-1 text-xs text-[color:var(--color-muted)]">
    {subText}
  </p>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    {
      grouped.map((g) => (
        <div>
          <h3 class="text-[11px] uppercase tracking-wider text-[color:var(--color-muted)] font-semibold">
            {g.group}
          </h3>
          <ul class="mt-3 space-y-3" role="list">
            {g.items.map(({ key, score, provided }) => {
              const label = labels[key as CriterionKey].name;
              const color = colorFor(score);
              return (
                <li>
                  <div class="flex items-center justify-between gap-3 text-sm">
                    <span class="text-[color:var(--color-ink)] dark:text-[color:var(--color-paper)]">
                      {label}
                      {!provided && (
                        <span class="ml-1.5 text-[10px] uppercase tracking-wider text-[color:var(--color-muted)]">
                          N/A
                        </span>
                      )}
                    </span>
                    <span class="font-mono tabular-nums text-[color:var(--color-muted)]">
                      {score}<span class="opacity-50">/10</span>
                    </span>
                  </div>
                  <div class="mt-1.5 h-1 rounded-full bg-[color:var(--color-line)]/60 dark:bg-stone-800 overflow-hidden">
                    <div
                      class:list={[
                        'h-full rounded-full',
                        provided ? tone[color] : tone.muted,
                      ]}
                      style={`width: ${(score / 10) * 100}%`}
                    />
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</div>
