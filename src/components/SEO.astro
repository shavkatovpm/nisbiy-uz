---
import { site } from '../lib/site';
import { localePath, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: Lang;
  /** Optional URL (relative or absolute) of a parallel Markdown version of this page — exposed for AI/LLM consumers. */
  mdAlternate?: string;
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  type = 'website',
  publishedAt,
  updatedAt,
  canonical,
  jsonLd,
  lang = 'uz',
  mdAlternate,
} = Astro.props;

const canonicalURL = canonical
  ? new URL(canonical, site.url)
  : new URL(Astro.url.pathname, site.url);

const ogImageURL = new URL(image, site.url);
const fullTitle = title === site.name ? title : `${title} — ${site.shortName}`;

const ldArray = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

const ogLocale = lang === 'ru' ? 'ru_RU' : 'uz_UZ';
const contentLang = lang === 'ru' ? 'ru' : 'uz';

// hreflang alternates — derive sibling locale URL from canonical
const rawPath = (canonical ?? Astro.url.pathname).replace(/\/$/, '') || '/';
const uzPath = rawPath.startsWith('/ru') ? (rawPath === '/ru' ? '/' : rawPath.slice(3)) : rawPath;
const ruPath = localePath(uzPath, 'ru');

const uzAltUrl = new URL(uzPath === '/' ? '' : uzPath, site.url).href;
const ruAltUrl = new URL(ruPath, site.url).href;
---

<!-- Primary -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL.href} />
<meta name="generator" content={Astro.generator} />

<!-- Hreflang alternates -->
<link rel="alternate" hreflang="uz" href={uzAltUrl} />
<link rel="alternate" hreflang="ru" href={ruAltUrl} />
<link rel="alternate" hreflang="x-default" href={uzAltUrl} />

<!-- Charset / viewport -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />

<!-- Icons / manifest -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Discovery -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} — RSS`} href="/rss.xml" />
{mdAlternate && (
  <link rel="alternate" type="text/markdown" title={`${title} — Markdown`} href={new URL(mdAlternate, site.url).href} />
)}

<!-- Locale / robots -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta http-equiv="content-language" content={contentLang} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={lang === 'ru' ? 'uz_UZ' : 'ru_RU'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:image" content={ogImageURL.href} />
<meta property="og:image:alt" content={title} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitter} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL.href} />

<!-- JSON-LD -->
{
  ldArray.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  ))
}
